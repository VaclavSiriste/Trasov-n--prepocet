# PostgreSQL – lokálně nebo Supabase (heslo v URL musí být URL-enkódované: & → %26, % → %25)
# DATABASE_URL=postgresql://trasovani@127.0.0.1:5435/trasovani
DATABASE_URL=postgresql://postgres.PROJECT_REF:HESLO@aws-0-eu-west-1.pooler.supabase.com:5432/postgres?sslmode=require

# Veřejná URL aplikace (magic link v e-mailu)
APP_URL=http://127.0.0.1:8080

# Tajný klíč pro session a OTP tokeny (dlouhý náhodný řetězec)
APP_AUTH_SECRET=change_me_to_long_random_string

# Povolené domény e-mailů (oddělené čárkou)
AUTH_ALLOWED_DOMAINS=zaluzieee.cz,demaxia.cz,pokladameee.cz

# Lokální vývoj bez přihlášení (nepoužívat na produkci)
# AUTH_DISABLED=1

# SMTP – odeslání přihlašovacího kódu
SMTP_HOST=smtp.seznam.cz
SMTP_PORT=465
SMTP_USER=vase-adresa@zaluzieee.cz
SMTP_PASS=
SMTP_FROM=Trasování <vase-adresa@zaluzieee.cz>

# Raynet API
RAYNET_USERNAME=your@zaluzieee.cz
RAYNET_API_KEY=your-api-key-here
RAYNET_INSTANCE=demaxia
RAYNET_PREJEZDY_USERNAME=your@zaluzieee.cz
RAYNET_PREJEZDY_API_KEY=your-prejezdy-api-key-here
